# ──────────────────────────────────────────────
# Atlas Configuration
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev_password@localhost:5432/atlas
DATABASE_URL_SYNC=postgresql+psycopg2://atlas:atlas_dev_password@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# Google OAuth 2.0
# ──────────────────────────────────────────────
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Gmail API scopes (comma-separated)
# Start with readonly, add modify when label application is enabled
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.labels

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here
SECRET_KEY=your-session-secret-key-change-this

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Sync Settings
# ──────────────────────────────────────────────
INITIAL_SYNC_DAYS=180
SYNC_BATCH_SIZE=100

# ──────────────────────────────────────────────
# LLM (Google Gemini)
# ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
